# Repository root. Set this when the service is started outside the repository.
MLOPS_PROJECT_ROOT=C:\Users\HP\Desktop\MLOps

# Task 2 model bundle. Use a local path or a mounted artifact-store path.
MODEL_BUNDLE_PATH=Task2\artifacts\models\06_inference_bundle.joblib

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
MODEL_VERSION=task2-v1

# Future external services; keep real values in a local .env file.
# MLFLOW_TRACKING_URI=http://localhost:5000
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/olist


# Registry mode uses a reviewed numeric model version; restart after changing.
MODEL_SOURCE=local
